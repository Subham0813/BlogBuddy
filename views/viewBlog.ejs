<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('./partials/head.ejs')%>

    <title>Blogpage</title>
  </head>
  <body>
    <%- include('./partials/navbar.ejs')%>

    <div class="container my-5">
      <!-- Blog Card -->
      <div class="card">
        <!-- Blog Image -->
        <% if (blog.coverImageURL) { %>
        <img
          src="<%= blog.coverImageURL %>"
          class="card-img-top"
          alt="Blog Cover Image"
        />
        <% } %>

        <!-- Blog Content -->
        <div class="card-body">
          <h2 class="card-title"><%= blog.title %></h2>
          <p class="text-muted">
            Created by <strong><%= blog.createdBy.fullname %></strong> · <%= new
            Date(blog.createdBy.createdAt).toLocaleDateString('en-US', { year:
            'numeric', month: 'long', day: 'numeric' }) %>
          </p>
          <hr />
          <p class="card-text"><%= blog.body %></p>
        </div>
      </div>
      <div class="mt-5">
        <h5>Comments ( <%= comments.length %> )</h5>

        <% if (locals.user) { %>
        <form
          id="mainCommentForm"
          method="post"
          action="/user/blogs/comment/<%= blog._id %>"
        >
          <div class="mb-3">
            <textarea
              id="content"
              name="content"
              class="form-control"
              rows="2"
              placeholder="Write your comment here..."
            ></textarea>
          </div>
          <button type="submit" class="btn btn-primary">Post Comment</button>
        </form>
        <% } %>
      </div>

      <hr />

      <div class="container">
        <% locals.comments.forEach(comment => { %>
        <div class="card my-3">
          <div class="card-body d-flex">
            <!-- User Image -->
            <div class="me-3">
              <img
                src="<%= comment.createdBy.profileImageURL %>"
                alt="User Avatar"
                class="rounded-circle"
                style="width: 50px; height: 50px; object-fit: cover"
              />
            </div>

            <!-- Comment Content -->
            <div class="container">
              <h6 class="mb-1"><%= comment.createdBy.fullname %></h6>
              <p class="mb-0"><%= comment.content %></p>
              <small class="text-muted">
                Posted on <%= new
                Date(comment.createdAt).toLocaleDateString('en-US', { year:
                'numeric', month: 'short', day: 'numeric', hour: '2-digit',
                minute: '2-digit' }) %>
              </small>

              <!-- Likes and Reply -->
              <div
                class="w-full mt-2 d-flex justify-content-between align-items-center gap-4"
              >
                <form
                  action="/user/blogs/comment/<%= comment._id %>/like"
                  method="post"
                >
                  <button type="submit" class="btn btn-sm btn-outline-primary">
                    ❤️ 
                    <span><%= comment.likes || 0 %> </span>
                  </button>
                </form>

                <!-- Reply Button -->
                <button
                  class="btn btn-sm btn-outline-secondary reply-btn"
                  data-comment-id="<%= comment._id %>"
                >
                  💬 Reply
                </button>
              </div>

              <!-- Reply Form (hidden by default) -->
              <form
                class="reply-form mt-2 d-none"
                id="replyForm-<%= comment._id %>"
                method="POST"
                action="/user/blogs/comment/<%= blog._id %>/reply/<%= comment._id %>"
              >
                <textarea
                  id="replyContent"
                  name="replyContent"
                  class="form-control mb-2"
                  rows="2"
                  placeholder="Write your reply..."
                  required
                ></textarea>
                <button type="submit" class="btn btn-sm btn-success">
                  Post Reply
                </button>
              </form>
              <!-- Replies List -->
              <% if (comment.replies && comment.replies.length > 0) { %>
              <button
                class="btn btn-sm btn-link text-decoration-none toggle-replies-btn"
                data-comment-id="<%= comment._id %>"
              >
                View Replies (<%= comment.replies.length %>)
              </button>

              <div
                class="mt-3 ms-4 border-start ps-3 d-none"
                id="replies-<%= comment._id %>"
              >
                <h6>Replies (<%= comment.replies.length %>)</h6>
                <% comment.replies.forEach(reply => { %>
                <div class="mb-2">
                  <strong><%= reply.createdBy.fullname %></strong>
                  <p class="mb-1"><%= reply.message %></p>
                  <small class="text-muted">
                    Replied on <%= new
                    Date(reply.createdAt).toLocaleDateString('en-US', { year:
                    'numeric', month: 'short', day: 'numeric', hour: '2-digit',
                    minute: '2-digit' }) %>
                  </small>
                  <form
                    action="/user//blogs/comment/replies/<%= reply._id %>/like"
                    method="POST"
                    class="d-inline-block ms-2"
                  >
                    <button type="submit" class="btn btn-sm btn-outline-danger mr-2">
                      ❤️ <span> <%= reply.likes || 0 %></span>
                    </button>
                    
                  </form>
                </div>
                <% }) %>
              </div>
              <% } %>
            </div>
          </div>
        </div>
        <% }) %>
      </div>
    </div>

    <%- include('./partials/scripts.ejs')%>
  </body>
</html>
